flowchart LR
    classDef ent fill:#eef5f5,stroke:#0b6e6e,stroke-width:1.5px,color:#0b2a3b
    classDef hub fill:#fdf1e3,stroke:#d9822b,stroke-width:2px,color:#0b2a3b,font-weight:bold

    subgraph REF["reference"]
        direction TB
        REFL["23 code sets<br/>data_dictionary<br/>schema_migration"]:::ent
    end

    subgraph PARTYD["party"]
        direction TB
        PTY["party"]:::ent
        PTYR["party_role<br/>(5 contexts)"]:::ent
    end

    subgraph POLICYD["policy"]
        direction TB
        QUOTE["quote"]:::hub
        POL["policy"]:::hub
        ENDT["endorsement"]:::ent
        COV["coverage"]:::ent
        INSOBJ["insured_object<br/>+ vehicle"]:::ent
        PREM["premium_transaction"]:::ent
        QUOTE --> POL
    end

    subgraph CLAIMD["claim"]
        direction TB
        CLM["claim"]:::hub
        CLMT["claim_transaction"]:::ent
    end

    subgraph REINSD["reinsurance"]
        direction TB
        TREATY["submission →<br/>treaty + layers"]:::hub
        CES["cession"]:::hub
        CAT["cat_event"]:::ent
        EVL["event_loss"]:::ent
        CES --> TREATY
    end

    subgraph LIFED["life"]
        direction TB
        MP["model_point"]:::ent
        AS["assumption_set"]:::ent
        SS["scenario_set"]:::ent
        VR["valuation_run<br/>(+assumptions)"]:::hub
    end

    subgraph FIND["finance"]
        direction TB
        VALRES["valuation_result<br/>measure codes: BEL…CSM"]:::hub
    end

    subgraph EXCHD["exchange"]
        direction TB
        BORD["bordereau lines<br/>in / out"]:::ent
    end

    subgraph SEMD["semantics"]
        direction TB
        MV["4 metric views"]:::ent
    end

    REF ~~~ PARTYD ~~~ POLICYD ~~~ CLAIMD ~~~ REINSD ~~~ LIFED ~~~ FIND ~~~ EXCHD ~~~ SEMD

    CLM --> POL
    CES --> POL
    VALRES --> VR
